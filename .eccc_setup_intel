#!/bin/bash

# For internal use at ECCC

# Source this file to:
# - Load profile, Intel compiler, and code-tools for Intel
# - Load libraries
# - Load a script for common setup to all compilers

export COMPILER_SUITE=intel
export COMPILER_VERSION=2022.1.2

# Load code-tools 
. r.load.dot rpn/code-tools/20250521/env/inteloneapi-${COMPILER_VERSION}

# Load netcdf
. r.load.dot /fs/ssm/main/opt/hdf5-netcdf4/serial/static/inteloneapi-2022.1.2/02

# Load latest version of RPN-SI libraries and utilities
. r.load.dot rpn/libs/20241105-alpha
. r.load.dot rpn/utils/20241105-alpha

# Check and tell if maestro is loaded
if [ -z "${MAESTRO_VERSION}" ]; then
    echo ""
    echo "Maestro is not loaded: SCM task setup scripts will be used instead of maestro scripts."
else
    echo "Maestro ${MAESTRO_VERSION} scripts will be used"
fi

. ./.common_setup ${COMPILER_SUITE}

# Set WITH_SYSTEM_RPN variable with default value TRUE for ECCC users
export WITH_SYSTEM_RPN=TRUE
